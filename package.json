{
  "name": "leakloop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --import tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "evaluate": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx tests/integration.ts",
    "test:api": "node --env-file-if-exists=.env.local --import tsx tests/api.ts",
    "auth:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-users.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "worker:once": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts --once",
    "test:backend": "node --env-file-if-exists=.env.local --import tsx tests/backend.ts",
    "local": "node --env-file-if-exists=.env.local --import tsx scripts/serve.ts",
    "maintenance": "node --env-file-if-exists=.env.local --import tsx scripts/maintenance.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run auth:seed",
    "local:macos": "python3 scripts/local-macos.py",
    "test:accounts": "node --env-file-if-exists=.env.local --import tsx tests/accounts.ts",
    "test:telemetry": "node --env-file-if-exists=.env.local --import tsx tests/telemetry.ts",
    "test:attachments": "node --env-file-if-exists=.env.local --import tsx tests/attachments.ts",
    "test:live-agent": "node --env-file-if-exists=.env.local --import tsx tests/live-agent.ts",
    "agent:check": "node --env-file-if-exists=.env.local --import tsx scripts/agent-check.ts",
    "db:backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "db:restore": "node --env-file-if-exists=.env.local --import tsx scripts/restore.ts",
    "test:restore": "node --env-file-if-exists=.env.local --import tsx tests/restore.ts",
    "test:http": "node --env-file-if-exists=.env.local --import tsx tests/http-production.ts",
    "auth:bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap-manager.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "jose": "^6.2.16",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "^3.5.13",
    "@types/three": "^0.187.0",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
