# Server-only direct/session-pooler Postgres URL (local Postgres or Supabase).
DATABASE_URL=postgresql://leakloop@127.0.0.1:55433/postgres
AUTH_MODE=password
ALLOW_DEMO_LOGIN=false
# Explicit deterministic demo; no model credentials required.
AGENT_MODE=demo
# To enable API-backed agent jobs: set AGENT_MODE=live, key, and model in BOTH API and worker.
OPENAI_API_KEY=
OPENAI_MODEL=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
PORT=3001
