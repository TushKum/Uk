# LeakLoop server configuration. Copy to .env.local (never commit it).
# Every value here is server-side only; nothing is sent to the browser except the public
# flags exposed by /api/auth/config. Leave a value empty to use its default.

# ---- Core ----
# Server-only direct/session-pooler Postgres URL (local Postgres or Supabase).
DATABASE_URL=postgresql://leakloop@127.0.0.1:55433/postgres
PORT=3001
# local = loopback workstation use (default). hosted = reachable by other machines; enforces
# an https APP_ORIGIN, secure cookies and disabled demo login.
DEPLOYMENT_PROFILE=local
# Public origin of the app. Used for same-origin checks, invitation/reset links and SSO redirects.
APP_ORIGIN=http://127.0.0.1:3001
# auto (Secure when APP_ORIGIN/request is https) | true | false
COOKIE_SECURE=auto
# Only set when a trusted reverse proxy sets X-Forwarded-For (enables per-client rate limits).
TRUST_PROXY=false
LOG_LEVEL=info

# ---- Authentication ----
AUTH_MODE=password
ALLOW_DEMO_LOGIN=false
PASSWORD_LOGIN=true
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
INVITATION_HOURS=72
PASSWORD_RESET_MINUTES=30
# Account email: file (local owner-only outbox, nothing leaves the machine) | smtp | disabled
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=
# Only after outbound email is authorised, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=
# Optional OpenID Connect SSO. All three of issuer, client id and secret are required together.
# Register the redirect URI <APP_ORIGIN>/api/auth/sso/callback with your identity provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_DISPLAY_NAME=
# Comma-separated email domains allowed to link by verified email (empty = any verified email that matches an account).
OIDC_ALLOWED_DOMAINS=

# ---- Agent ----
# demo = deterministic policy, no external calls. live = OpenAI Responses API (set in BOTH app and worker).
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
AGENT_MODEL_TIMEOUT_MS=8000
AGENT_MAX_OUTPUT_TOKENS=350
# Both or neither. Without them, live costs are recorded as unavailable (never as zero).
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=

# ---- Evidence attachments ----
# local (STORAGE_LOCAL_DIR, default ./.data/attachments) | s3 (any S3-compatible store)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=
# S3 credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, profile or instance role).
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENTS_PER_INCIDENT=50
ATTACHMENT_PURGE_DAYS=30

# ---- Real telemetry ingestion ----
TELEMETRY_BATCH_MAX=500
TELEMETRY_MAX_AGE_DAYS=30
TELEMETRY_MAX_FUTURE_SECONDS=300
# 0 = keep device readings indefinitely
TELEMETRY_RETENTION_DAYS=0

# ---- Backups ----
BACKUP_DIR=
